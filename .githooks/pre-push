#!/bin/bash

echo "Running pre-push checks..."

# 1. Check format
echo "Running cargo fmt --all --check..."
if ! cargo fmt --all --check; then
    echo "Error: cargo fmt failed. Running cargo fmt --all to fix..."
    cargo fmt --all
    echo "Fixed formatting. Please re-run the push."
    exit 1
fi

# 2. Run light baseline tests (unit tests only)
echo "Running light baseline tests (unit tests)..."
if ! cargo test --lib --quiet; then
    echo "Error: Unit tests failed. Please fix before pushing."
    exit 1
fi

echo "All checks passed."
exit 0
